{
  "name": "odyssey-music",
  "version": "0.1.0",
  "description": "Culture Graph — background crawler + agent that materializes the music culture graph (Phase 1)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --exclude 'test/**/*.live.test.ts'",
    "test:live": "vitest --run test/agent.live.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "crawl": "tsx src/cli.ts"
  },
  "bin": {
    "odyssey-crawl": "./bin/odyssey-crawl.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "commander": "^12.1.0",
    "typebox": "^1.1.24",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
