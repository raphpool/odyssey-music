{
  "name": "odyssey-music",
  "version": "0.1.0",
  "description": "Culture Graph — background crawler + agent that materializes the music culture graph (Phase 1)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --exclude 'test/**/*.live.test.ts'",
    "test:live": "vitest --run test/pipeline.live.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "crawl": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "build:graph": "tsx scripts/build-graph-json.ts cache web/data.json",
    "build:genre-qid-map": "tsx scripts/build-genre-qid-map.ts",
    "migrate:genre-qid": "tsx scripts/migrations/2026-09-04-backfill-genre-qid.ts",
    "migrate:genre-merge": "tsx scripts/migrations/2026-09-04-merge-genre-duplicates.ts",
    "audit:cache": "tsx scripts/audit-cache.ts",
    "translate:nodes": "tsx scripts/translate-nodes.ts",
    "analyze:coverage": "tsx scripts/analyze-coverage.ts",
    "analyze:genre-coverage": "tsx scripts/analyze-genre-coverage.ts",
    "report:genre-dupes": "tsx scripts/report-genre-duplicates.ts",
    "topup:genres": "tsx scripts/top-up-genres.ts",
    "topup:dangling": "tsx scripts/top-up-dangling.ts",
    "smoke:pipeline": "tsx scripts/smoke-pipeline.ts",
    "deploy:web": "bash scripts/deploy-web.sh",
    "deploy:server": "bash deploy/deploy-server.sh"
  },
  "bin": {
    "odyssey-crawl": "./bin/odyssey-crawl.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@mozilla/readability": "^0.6.0",
    "commander": "^12.1.0",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "typebox": "^1.1.24",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
