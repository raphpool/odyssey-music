{
  "model": "sonnet",
  "effort": "high",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Read",
      "Grep",
      "Glob",
      "mcp__Figma"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(npm run deploy:*)",
      "Bash(bash scripts/deploy-web.sh*)",
      "Bash(bash deploy/deploy-server.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh",
            "statusMessage": "Formatage du fichier modifié…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.sh",
            "statusMessage": "Typecheck + lint + tests…"
          }
        ]
      }
    ]
  }
}
