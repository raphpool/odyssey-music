.DS_Store

# Local crawl outputs
/tmp/
out/
# The shared cache (./cache) IS committed — it's the project's persistent KB.
# Sub-runs may write to ./cache/* and get checked in; the schema gate guarantees
# every cached file is a real grounded node, never a stub.
#
# Resolver sidecars are the exception: they are derived, re-resolvable lookups
# against third-party catalogs (YouTube video ids, Spotify/Apple Music links),
# not knowledge. They live next to the cache so the server can reuse them across
# restarts, but versioning them would churn the repo with data we can regenerate.
cache/youtube/
cache/links/
cache/images/

# Codex review artifacts (kept under .reviews/ but only the latest verdict is committed)
.reviews/raw/
.reviews/*.log

# Deploy provenance markers, written by scripts/deploy-web.sh + deploy/deploy-server.sh.
# Server reads .deployed-sha to serve /version; never committed.
.deployed-sha
web/.deployed-sha

# web/data.json is generated (npm run build:graph, scripts/deploy-web.sh) and was stale in git:
# 1392 nodes vs 1618 in cache/, no taxonomy (2026-10-14, TRA-460). Never committed.
web/data.json

# Permissions locales de Claude Code — personnelles, jamais versionnées
.claude/settings.local.json

# Swift package build artifacts (Track1Core)
ios/Track1Core/.build/
ios/Track1Core/.swiftpm/
